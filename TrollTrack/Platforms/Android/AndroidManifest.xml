<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<queries>
		<!-- Needed for MediaPicker.CapturePhotoAsync() -->
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>

		<!-- Optional: helpful for picking images via file pickers -->
		<intent>
			<action android:name="android.intent.action.GET_CONTENT" />
			<data android:mimeType="image/*" />
		</intent>

		<!-- Android 11+ package visibility: apps that handle SEND (Drive, Gmail, Files, etc.) -->
		<intent>
			<action android:name="android.intent.action.SEND" />
			<data android:mimeType="application/octet-stream" />
		</intent>
	</queries>
	
	<application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Maui.SplashTheme"
		android:icon="@mipmap/trolltrack_app_icon"
		android:roundIcon="@mipmap/trolltrack_app_icon">
		<!-- Google Maps API key - replace with your key from Google Cloud Console -->
		<meta-data android:name="com.google.android.geo.API_KEY" android:value="GOOGLE_MAPS_API_KEY_PLACEHOLDER" />
		<meta-data android:name="com.google.android.gms.version" android:value="@integer/google_play_services_version" />

		<!-- Share exported DB from app cache (content:// URI) -->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="com.trolltrack.fishing.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths_share" />
		</provider>
	</application>

	<!-- Network permissions -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Location permissions for GPS -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

	<!-- For background location (if needed) -->
	<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

	<!-- Required for Geolocation.StartListeningForegroundAsync (continuous GPS tracking during trips) -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

	<!-- For storing catch data -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

	<!-- Camera permission (if you want to take photos of catches) -->
	<uses-permission android:name="android.permission.CAMERA" />

	<!-- Required hardware features -->
	<uses-feature android:name="android.hardware.location" android:required="false" />
	<uses-feature android:name="android.hardware.location.gps" android:required="false" />
	<uses-feature android:name="android.hardware.location.network" android:required="false" />

	<!-- Minimum SDK version -->
	<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />
</manifest>