<?xml version="1.0" encoding="utf-8"?>
<!--
  SdkOnly linking can remove MAUI Android Shell / NavigationRootManager code that is only
  reached via JNI or reflection. Preserve MAUI assemblies so the app still starts; BCL
  assemblies remain linkable → much smaller AAB than AndroidLinkMode=None.
-->
<linker>
	<assembly fullname="Microsoft.Maui" preserve="all" />
	<assembly fullname="Microsoft.Maui.Controls" preserve="all" />
	<assembly fullname="Microsoft.Maui.Controls.Xaml" preserve="all" />
	<assembly fullname="Microsoft.Maui.Controls.Compatibility" preserve="all" />
	<assembly fullname="Microsoft.Maui.Essentials" preserve="all" />
	<assembly fullname="Microsoft.Maui.Graphics" preserve="all" />
	<assembly fullname="Microsoft.Maui.Controls.Maps" preserve="all" />
</linker>
