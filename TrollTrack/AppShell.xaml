<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrollTrack.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:TrollTrack.Features.Dashboard"
    xmlns:catches="clr-namespace:TrollTrack.Features.Catches"
    xmlns:programs="clr-namespace:TrollTrack.Features.Programs"
    xmlns:lures="clr-namespace:TrollTrack.Features.Lures"
    xmlns:analytics="clr-namespace:TrollTrack.Features.Analytics"
    xmlns:settings="clr-namespace:TrollTrack.Features.Settings"
    xmlns:about="clr-namespace:TrollTrack.Features.About"
    Title="TrollTrack"
    Shell.FlyoutBehavior="Disabled">

    <TabBar x:Name="MainTabBar">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate dashboard:DashboardView}"
            Route="Dashboard" />
        <ShellContent
            Title="Trips"
            ContentTemplate="{DataTemplate catches:CatchesView}"
            Route="Trips" />
        <ShellContent
            Title="Lures"
            ContentTemplate="{DataTemplate lures:LuresView}"
            Route="Lures"  />
        <ShellContent
            Title="Analytics"
            ContentTemplate="{DataTemplate analytics:AnalyticsView}"
            Route="Analytics" />
        <ShellContent x:Name="SettingsTab"
            Title="Settings"
            ContentTemplate="{DataTemplate settings:SettingsView}"
            Route="Settings" />
        <!-- Inline page (not DataTemplate) so XAML Clicked handlers in code-behind wire correctly -->
        <ShellContent x:Name="AboutTab"
            Title="About"
            Route="About">
            <about:AboutView />
        </ShellContent>
    </TabBar>
</Shell>