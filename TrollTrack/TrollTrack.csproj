<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>TrollTrack</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>TrollTrack</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.trolltrack.fishing</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1.9</ApplicationDisplayVersion>
		<ApplicationVersion>9</ApplicationVersion>

		<!-- Android specific settings -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<GeneratePackageOnBuild Condition="'$(TargetFramework)' == 'net9.0-android'">true</GeneratePackageOnBuild>
		<AndroidKeyStore>false</AndroidKeyStore>
		
		<!-- Force APK generation -->
		<AndroidPackageFormats Condition="'$(TargetFramework)' == 'net9.0-android'">apk</AndroidPackageFormats>
		
		<!-- Debug settings -->
		<EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">false</EmbedAssembliesIntoApk>
		<AndroidLinkMode Condition="'$(Configuration)' == 'Debug'">None</AndroidLinkMode>
		<AndroidCreatePackagePerAbi Condition="'$(Configuration)' == 'Debug'">false</AndroidCreatePackagePerAbi>
		<AndroidUseSharedRuntime Condition="'$(Configuration)' == 'Debug'">true</AndroidUseSharedRuntime>
		
		<!-- Release: SdkOnly keeps AAB size down; MAUI assemblies preserved via LinkDescription (see below). -->
		<AndroidLinkMode Condition="'$(Configuration)' == 'Release'">SdkOnly</AndroidLinkMode>
		<RunAOTCompilation Condition="'$(Configuration)' == 'Release'">false</RunAOTCompilation>
		<AndroidCreatePackagePerAbi Condition="'$(Configuration)' == 'Release'">false</AndroidCreatePackagePerAbi>
		<AndroidUseSharedRuntime Condition="'$(Configuration)' == 'Release'">false</AndroidUseSharedRuntime>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<MauiXamlC>true</MauiXamlC>
	</PropertyGroup>

	<!-- Optional: copy TrollTrack.Local.props.example to TrollTrack.Local.props and fill in your secrets (gitignored). Environment variables override the file when set. -->
	<Import Project="$(MSBuildThisFileDirectory)TrollTrack.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)TrollTrack.Local.props')" />

	<!-- Env var overrides Local.props for the Maps key when present -->
	<PropertyGroup>
		<GoogleMapsApiKey Condition="'$(GOOGLE_MAPS_API_KEY)' != ''">$(GOOGLE_MAPS_API_KEY)</GoogleMapsApiKey>
		<!-- Ensures the Maps key is merged into the final manifest for dotnet publish / AAB (post-_CompileToDalvik PowerShell was unreliable). -->
		<AndroidManifestPlaceholders Condition="'$(GoogleMapsApiKey)' != ''">MAPS_API_KEY=$(GoogleMapsApiKey)</AndroidManifestPlaceholders>
		<AssemblyVersion>0.1.0.1</AssemblyVersion>
		<FileVersion>0.1.0.1</FileVersion>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <!-- Do not set AndroidPackageFormat to aab here: VS/device Install uses the AAB pipeline and runs adb uninstall first, which wipes app data. Default apk (see top of file) uses adb install -r and keeps your database. -->
	  <!-- Must be false unless AndroidSigningKeyStore + alias/passwords are set; true with no path causes MSB4044 KeyStore. -->
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<!-- Release Android: use android-signing/release.keystore only when that file exists; otherwise use default debug signing (avoids MSB4044 KeyStore empty). -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <!-- Same as Debug: aab + Install from VS uninstalls the app and wipes SQLite. Keep apk for local deploy; see Play Store doc for AAB command. -->
	  <AndroidKeyStore Condition="Exists('$(MSBuildThisFileDirectory)..\android-signing\release.keystore')">True</AndroidKeyStore>
	  <AndroidKeyStore Condition="!Exists('$(MSBuildThisFileDirectory)..\android-signing\release.keystore')">False</AndroidKeyStore>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU' And Exists('$(MSBuildThisFileDirectory)..\android-signing\release.keystore')">
	  <!-- Set TROLLTRACK_ANDROID_KEY_ALIAS, TROLLTRACK_ANDROID_KEY_PASS, TROLLTRACK_ANDROID_STORE_PASS in your environment (do not commit secrets). -->
	  <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\android-signing\release.keystore</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias>$(TROLLTRACK_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass>$(TROLLTRACK_ANDROID_KEY_PASS)</AndroidSigningKeyPass>
	  <AndroidSigningStorePass>$(TROLLTRACK_ANDROID_STORE_PASS)</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- Fail early if no Google Maps API key is configured -->
	<Target Name="_CheckGoogleMapsApiKey" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net9.0-android'">
		<Error Text="GoogleMapsApiKey is not set. Set GOOGLE_MAPS_API_KEY env var (restart VS after adding it), or copy TrollTrack.Local.props.example to TrollTrack.Local.props and paste your key. Or pass /p:AllowAndroidMapsWithoutApiKey=true to skip." Condition="'$(GoogleMapsApiKey)' == '' And '$(AllowAndroidMapsWithoutApiKey)' != 'true' And '$(DesignTimeBuild)' != 'true'" />
		<Warning Text="GoogleMapsApiKey not set; Maps will not work until you set the key and rebuild." Condition="'$(GoogleMapsApiKey)' == '' And '$(AllowAndroidMapsWithoutApiKey)' == 'true'" />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\trolltrack_app_icon.png" BaseSize="1024,1024" Color="#FFFFFFFF" />

		<!-- Styles -->
		<MauiXaml Update="Resources\Styles\*.xaml">
			<SubType>Designer</SubType>
		</MauiXaml>
		
		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Remove="Services\IRodSetupService.cs" />
		<Compile Remove="Services\RodSetupService.cs" />
		<None Remove="Resources\Images\Lures\Bandit_BlueShiner.png" />
		<None Remove="Resources\Images\Lures\Bandit_ChromeBlackBack.png" />
		<None Remove="Resources\Images\Lures\Bandit_ChromeBlueBack.png" />
		<None Remove="Resources\Images\Lures\Bandit_CoconutCandy.png" />
		<None Remove="Resources\Images\Lures\bandit_deepcrank_blueshiner.png" />
		<None Remove="Resources\Images\Lures\bandit_deepcrank_chromeblackback.png" />
		<None Remove="Resources\Images\Lures\bandit_deepcrank_chromeblueback.png" />
		<None Remove="Resources\Images\Lures\bandit_deepcrank_coconutcandy.png" />
		<None Remove="Resources\Images\Lures\bandit_deepcrank_humblebee.png" />
		<None Remove="Resources\Images\Lures\bandit_deepcrank_purplemist.png" />
		<None Remove="Resources\Images\Lures\Bandit_HumbleBee.png" />
		<None Remove="Resources\Images\Lures\Bandit_PurpleMist.png" />
		<None Remove="Resources\Images\Lures\eye_slammer_weapon_rig_atomic_blueberry.png" />
		<None Remove="Resources\Images\Lures\eye_slammer_weapon_rig_mtn_dew.png" />
		<None Remove="Resources\Images\Lures\inline_trolling_keel_weight.png" />
		<None Remove="Resources\Images\Lures\inline_trolling_weight.png" />
		<None Remove="Resources\Images\Lures\moonshine_lures_agent_orange.png" />
		<None Remove="Resources\Images\Lures\moonshine_lures_jj_mac_muffin.png" />
		<None Remove="Resources\Images\Lures\walleye_sport_fruit_loopz_walleye_weapon.png" />
		<EmbeddedResource Include="Configuration\appsettings.json" />
	</ItemGroup>

	<ItemGroup>
	  <MauiImage Include="Resources\Images\Lures\bandit_deepcrank_blueshiner.png" />
	  <MauiImage Include="Resources\Images\Lures\bandit_deepcrank_chromeblackback.png" />
	  <MauiImage Include="Resources\Images\Lures\bandit_deepcrank_chromeblueback.png" />
	  <MauiImage Include="Resources\Images\Lures\bandit_deepcrank_coconutcandy.png" />
	  <MauiImage Include="Resources\Images\Lures\bandit_deepcrank_humblebee.png" />
	  <MauiImage Include="Resources\Images\Lures\bandit_deepcrank_purplemist.png" />
	  <MauiImage Include="Resources\Images\Lures\eye_slammer_weapon_rig_atomic_blueberry.png" />
	  <MauiImage Include="Resources\Images\Lures\eye_slammer_weapon_rig_mtn_dew.png" />
	  <MauiImage Include="Resources\Images\Lures\inline_trolling_keel_weight.png" />
	  <MauiImage Include="Resources\Images\Lures\inline_trolling_weight.png" />
	  <MauiImage Include="Resources\Images\Lures\moonshine_lures_agent_orange.png" />
	  <MauiImage Include="Resources\Images\Lures\moonshine_lures_jj_mac_muffin.png" />
	  <MauiImage Include="Resources\Images\Lures\walleye_sport_fruit_loopz_walleye_weapon.png" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<LinkDescription Include="Platforms\Android\TrollTrack.LinkDescription.xml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.110" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="9.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
		
		<!-- Essential packages for your fishing app -->
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLiteNetExtensions" Version="2.1.0" />
		<PackageReference Include="SQLiteNetExtensions.Async" Version="2.1.0" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

	<!-- Platform specific configurations -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.110" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Features\Catches\ActiveTripView.xaml.cs">
	    <DependentUpon>NewTripView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Catches\CatchDetailPopup.xaml.cs">
	    <DependentUpon>CatchDetailPopup.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Catches\TripCatchesPopup.xaml.cs">
	    <DependentUpon>TripCatchesPopup.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Lures\AddLurePopup.xaml.cs">
	    <DependentUpon>AddLurePopup.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <MauiXaml Update="Features\Catches\CatchesView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Catches\ActiveTripView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Catches\CatchDetailPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Catches\TripCatchesPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Lures\AddLurePopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\RodSetup\LureFilterPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\RodSetup\LureSelectionPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\RodSetup\RodSetupPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Settings\SettingsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>