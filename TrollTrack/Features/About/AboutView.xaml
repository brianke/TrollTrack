<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrollTrack.Features.About.AboutView"
             Title="About"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20" Margin="0,40,0,0">
            <Label Text="🎣 TrollTrack"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label x:Name="VersionLabel"
                   FontSize="16"
                   TextColor="#666666"
                   HorizontalOptions="Center"/>
            <Label Text="Fishing trip and catch tracking"
                   FontSize="14"
                   TextColor="#888888"
                   HorizontalOptions="Center"/>

            <Label x:Name="CopyrightLabel"
                   FontSize="12"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10"/>   
            
            <Button Text="📤 Export Database"
                    Clicked="OnExportDatabaseClicked"
                    BackgroundColor="#2E8BC0"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    Margin="0,20,0,0"/>

            <Button Text="📥 Import Database"
                    Clicked="OnImportDatabaseClicked"
                    BackgroundColor="#C05C2E"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    Margin="0,10,0,0"/>
            
            <VerticalStackLayout Spacing="8"
                                 Margin="0,8,0,0"
                                 HorizontalOptions="Fill">
                <Label Text="Version 0.1.9"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       HorizontalOptions="Center"/>
                <Label FontSize="14"
                       TextColor="#444444"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="Fill"
                       Text="&#x2022; Updated Lures page to show larger images and more details.&#10;&#x2022; Added ability to edit existing lures.&#10;&#x2022; Fixed issue with using a newly added lure in a current trip.&#10;"/>
                <Label Text="Version 0.1.7"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       HorizontalOptions="Center"/>
                <Label FontSize="14"
                       TextColor="#444444"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="Fill"
                       Text="&#x2022; Fixed issue with color picker hiding 'Done' and 'Close' buttons.&#10;"/>
                <Label Text="Version 0.1.6"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       HorizontalOptions="Center"/>
                <Label FontSize="14"
                       TextColor="#444444"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="Fill"
                       Text="&#x2022; Added Target Species to the New Trip details.&#10;&#x2022; Added option to Export and Import database.&#10;&#x2022; Added new species for Trout and Salmon.&#10;&#x2022; Added new Cannonballs to Diver options."/>
            </VerticalStackLayout>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
