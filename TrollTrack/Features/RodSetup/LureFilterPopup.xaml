<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrollTrack.Features.RodSetup"
             xmlns:e="clr-namespace:TrollTrack.Features.RodSetup"
             x:Class="TrollTrack.Features.RodSetup.LureFilterPopup"
             x:DataType="vm:RodSetupViewModel"
             Title="Filter Lures"
             BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1C1C1C}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Label Grid.Row="0" Text="Select filters"
               FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"
               Margin="0,10,0,15"
               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                <!-- Manufacturer -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Manufacturer" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                    <CollectionView ItemsSource="{Binding FilterManufacturers}"
                                   SelectionMode="None"
                                   MaximumHeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:FilterOption">
                                <Grid ColumnDefinitions="Auto,*" Padding="4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Lure Type -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Lure Type" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                    <CollectionView ItemsSource="{Binding FilterLureTypes}"
                                   SelectionMode="None"
                                   MaximumHeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:FilterOption">
                                <Grid ColumnDefinitions="Auto,*" Padding="4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Buoyancy -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Buoyancy" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                    <CollectionView ItemsSource="{Binding FilterBuoyancies}"
                                   SelectionMode="None"
                                   MaximumHeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:FilterOption">
                                <Grid ColumnDefinitions="Auto,*" Padding="4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Front Colors -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Front Colors" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                    <CollectionView ItemsSource="{Binding FilterFrontColors}"
                                   SelectionMode="None"
                                   MaximumHeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:FilterOption">
                                <Grid ColumnDefinitions="Auto,*" Padding="4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Back Colors -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Back Colors" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                    <CollectionView ItemsSource="{Binding FilterBackColors}"
                                   SelectionMode="None"
                                   MaximumHeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:FilterOption">
                                <Grid ColumnDefinitions="Auto,*" Padding="4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DisplayName}" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,20,0,0">
            <Button Grid.Column="0" Text="Clear" Command="{Binding ClearFiltersCommand}"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                    FontSize="16" CornerRadius="10" HeightRequest="50"/>
            <Button Grid.Column="1" Text="Apply" Command="{Binding ApplyFiltersCommand}"
                    BackgroundColor="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"
                    TextColor="#FFFFFF" FontSize="16" CornerRadius="10" HeightRequest="50"/>
        </Grid>
    </Grid>
</ContentPage>