<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrollTrack.Features.RodSetup"
             xmlns:vml="clr-namespace:TrollTrack.Features.Lures"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             x:Class="TrollTrack.Features.RodSetup.RodSetupPopup"
             x:DataType="vm:RodSetupViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1C1C1C}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,10,0,20">
            <Label Text="{Binding Title}"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
            <Label Text="Select a lure and set line out distance"
                   FontSize="16"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">

                <!-- Line Out Entry Section -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                        Padding="20"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#40000000, Dark=#80000000}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Line Out Distance"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0"
                                   Text="{Binding LineOut}"
                                   Placeholder="Enter distance"
                                   Keyboard="Numeric"
                                   FontSize="16"
                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                                   PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}"/>

                            <Label Grid.Column="1"
                                   Text="feet"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </Grid>

                        <Label Text="Distance of line from boat to lure"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Diver Entry Section -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                        Padding="20"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#40000000, Dark=#80000000}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Diver Used"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Picker ItemsSource="{Binding LuresViewModel.Divers}"
                                SelectedItem="{Binding SelectedDiver, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding DisplayName}" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Lure Selection Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Select Lure"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                           Margin="0,0,0,5"/>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                      IsVisible="{Binding IsLoading}"
                                      Color="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center"
                                      HeightRequest="100"/>

                    <!-- Lures Collection View -->
                    <CollectionView ItemsSource="{Binding LuresViewModel.Lures}"
                                   SelectionMode="Single"
                                   SelectedItem="{Binding SelectedLure}"
                                   IsVisible="{Binding IsNotBusy}"
                                   MaximumHeightRequest="400">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:LureDataEntity">
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                                        Padding="15"
                                        Margin="0,5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#40000000, Dark=#80000000}"
                                                Offset="0,2"
                                                Radius="6"
                                                Opacity="0.2"/>
                                    </Border.Shadow>

                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="15">
                                        <!-- Lure Image -->
                                        <Border Grid.Column="0"
                                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                                               StrokeThickness="0"
                                               HeightRequest="70"
                                               WidthRequest="70">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding PrimaryImage.Path}"
                                                   Aspect="AspectFit"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center"/>
                                        </Border>

                                        <!-- Lure Details -->
                                        <VerticalStackLayout Grid.Column="1" 
                                                            VerticalOptions="Center"
                                                            Spacing="8">
                                            <Label Text="{Binding Manufacturer}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                                            <Label Text="{Binding Color}"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"/>

                                            <!-- Lure Specifications
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5,0,0">
                                                <VerticalStackLayout Grid.Column="0">
                                                    <Label Text="Buoyancy"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"/>
                                                    <Label Text="{Binding Buoyancy}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"/>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="Dive Curve"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"/>
                                                    <Label Text="{Binding DiveCurve}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"/>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="2">
                                                    <Label Text="Action"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"/>
                                                    <Label Text="{Binding ActionType}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"/>
                                                </VerticalStackLayout>
                                            </Grid>  -->
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <!-- Empty View when no lures -->
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" 
                                                HorizontalOptions="Center"
                                                Spacing="15"
                                                Padding="40">
                                <Label Text="📦"
                                       FontSize="60"
                                       HorizontalOptions="Center"/>
                                <Label Text="No Lures Available"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                <Label Text="Add lures from the Lures tab first"
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#888888, Dark=#999999}"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Selected Lure Display (when a lure is selected) -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasSelectedLure}"
                BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                Padding="15"
                Margin="0,10,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="✓"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                       VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Selected Lure:"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#1B5E20, Dark=#A5D6A7}"/>
                    <Label Text="{Binding SelectedLure.Manufacturer}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
                    <Label Text="{Binding SelectedLure.Color}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*,*" 
              ColumnSpacing="15"
              Margin="0,20,0,10">

            <!-- Cancel Button -->
            <Button Grid.Column="0"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                    TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"/>

            <!-- OK Button -->
            <Button Grid.Column="1"
                    Text="Add Rod"
                    Clicked="OnOkClicked"
                    BackgroundColor="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"
                    TextColor="#FFFFFF"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    IsEnabled="{Binding CanAddRod}"/>
        </Grid>
    </Grid>
</ContentPage>
