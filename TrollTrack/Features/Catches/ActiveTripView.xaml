<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrollTrack.Features.Catches.ActiveTripView"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             xmlns:b="clr-namespace:TrollTrack.Behaviors">

    <VerticalStackLayout>

        <!-- Active Trip Info Banner -->
        <Border Style="{StaticResource InfoCard}"
                BackgroundColor="{StaticResource Primary}" >
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="🎣" FontSize="24"/>
                <Label Text="{Binding ActiveTrip.TripName}"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

        </Border>

        <!-- End Trip Button -->
        <Button Text="End Trip"
                Command="{Binding EndActiveTripCommand}"
                BackgroundColor="{StaticResource Primary}"
                Margin="0,0,0,10"/>

        <!-- Add New Rod Section -->
        <Border Style="{StaticResource InfoCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Add Rod"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>
                <Button Text="+ Add Rod"
                                Style="{StaticResource CircularButton}"
                                WidthRequest="120"
                                HeightRequest="40"
                                CornerRadius="20"
                                Command="{Binding AddRodCommand}" />
            </VerticalStackLayout>
        </Border>

        <!-- Add Catch Section -->
        <Border Style="{StaticResource InfoCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Log New Catch"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>

                <Label Text="No rods configured. Add a rod first!"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray500}"
                               Margin="0,10"
                               IsVisible="{Binding HasNoRods}"/>

                <FlexLayout BindableLayout.ItemsSource="{Binding Rods}"
                                    Wrap="Wrap"
                                    JustifyContent="Center"
                                    AlignItems="Start"
                                    AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="e:RodSetupEntity">
                            <Border Margin="5"
                                    WidthRequest = "90"
                                    HeightRequest = "60"
                                    BackgroundColor = "{StaticResource BorderAccent}" 
                                    HorizontalOptions = "Center"
                                    VerticalOptions = "Center"
                                    StrokeThickness="3">
                                <!--Stroke="White"
                                    InputTransparent="False">-->
                                
                                <!-- Round the corners of the border -->
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <!-- Tap to add a catch -->
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={x:Reference ActiveTripView}, Path=BindingContext.OnAddCatchTapped}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                    <!-- Long press to edit rod -->
                                <Border.Behaviors>
                                    <b:LongPressBehavior 
                                            Command="{Binding Source={x:Reference ActiveTripView}, Path=BindingContext.EditRodCommand}"
                                            CommandParameter="{Binding .}"
                                            Duration="500" />
                                </Border.Behaviors>
                                <Label Style="{StaticResource RodInfo}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       InputTransparent="True"
                                       IsEnabled="False">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <!-- Rod Number -->
                                            <Span Text="{Binding Name}" 
                                                          FontSize="16" 
                                                          FontAttributes="Bold" />

                                            <!-- Lure Info -->
                                            <!--<Span Text="{Binding Lure.Manufacturer}" 
                                                          FontSize="16" 
                                                          FontAttributes="Bold" />
                                                    <Span Text=" " 
                                                          FontSize="16" />
                                                    <Span Text="{Binding Lure.Color}" 
                                                          FontSize="16" 
                                                          FontAttributes="Bold,Italic" />-->

                                            <!-- Line Break -->
                                            <Span Text="&#10;" />

                                            <!-- Line Out -->
                                            <Span Text="{Binding LineOut}" 
                                                          FontSize="12" 
                                                          TextColor="White" />
                                            <Span Text=" feet" 
                                                          FontSize="12" 
                                                          TextColor="White" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Border>
                        </DataTemplate>
                        <!--<DataTemplate x:DataType="e:RodEntity">
                                    <Border Style="{StaticResource InfoCard}"
                                            Margin="5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAddCatchTapped"/>
                                        </Border.GestureRecognizers>

                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource CardTitle}"
                                                   HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>-->
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

            </VerticalStackLayout>
        </Border>

        <!-- Catches List -->
        <Border Style="{StaticResource InfoCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Catch History"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>

                <CollectionView ItemsSource="{Binding Catches}"
                                        SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No catches yet. Log your first catch!"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray500}"
                                       Margin="0,20"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="e:CatchDataEntity">
                            <SwipeView>
                                <!--<SwipeView.RightItems>
                                            <SwipeItems>
                                                <SwipeItem Text="Delete"
                                                          BackgroundColor="Red"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type f:CatchesViewModel}}, Path=DeleteCatchCommand}"
                                                          CommandParameter="{Binding .}"/>
                                            </SwipeItems>
                                        </SwipeView.RightItems>-->

                                <Border Style="{StaticResource InfoCard}"
                                                Margin="0,5">
                                    <Grid ColumnDefinitions="Auto,*,Auto" 
                                                  RowDefinitions="Auto,Auto,Auto"
                                                  ColumnSpacing="10"
                                                  RowSpacing="5">

                                        <!-- Fish Icon/Emoji -->
                                        <Label Text="🐟"
                                                       FontSize="32"
                                                       Grid.RowSpan="3"
                                                       VerticalOptions="Center"/>

                                        <!-- Species Name -->
                                        <Label Text="{Binding FishName}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       Grid.Column="1"
                                                       Grid.Row="0"/>

                                        <!-- Time -->
                                        <Label Text="{Binding Timestamp, StringFormat='{0:t}'}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource Gray500}"
                                                       Grid.Column="2"
                                                       Grid.Row="0"/>

                                        <!-- Location -->
                                        <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="📍 "/>
                                                    <Span Text="{Binding Latitude, StringFormat='{0:F4}'}"/>
                                                    <Span Text=", "/>
                                                    <Span Text="{Binding Longitude, StringFormat='{0:F4}'}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Date (if not today) -->
                                        <Label Text="{Binding Timestamp, StringFormat='{0:M/d/yyyy}'}"
                                                       Grid.Column="1"
                                                       Grid.Row="2"
                                                       Grid.ColumnSpan="2"
                                                       TextColor="{StaticResource Gray500}"
                                                       FontSize="12"/>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentView>
