<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrollTrack.Features.Catches.FishSelectionPopup"
             Title="Select Fish Species"
             BackgroundColor="#F8F8F8">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Label Grid.Row="0"
               Text="Select Fish Species"
               FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"
               Margin="0,10,0,20"
               TextColor="#1A1A1A"/>

        <CollectionView Grid.Row="1"
                        x:Name="FishList"
                        SelectionMode="Single"
                        SelectionChanged="OnFishSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border BackgroundColor="#FFFFFF"
                            Padding="18,14" Margin="0,4"
                            Stroke="#E0E0E0" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding .}"
                               FontSize="20"
                               TextColor="#1A1A1A"
                               VerticalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Cancel"
                Clicked="OnCancelClicked"
                BackgroundColor="#E0E0E0"
                TextColor="#333333"
                FontSize="16" FontAttributes="Bold" CornerRadius="10"
                HeightRequest="50" Margin="0,20,0,0"/>
    </Grid>
</ContentPage>
