<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="TrollTrack.Features.Catches.TripCatchesPopup"
             x:DataType="vm:TripCatchesDisplay"
             xmlns:vm="clr-namespace:TrollTrack.Features.Catches"
             Title="Trip Catches"
             BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1C1C1C}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,10,0,20">
            <!--<Label Text="🎣"
                   FontSize="48"
                   HorizontalOptions="Center"/>-->
            <Label Text="{Binding TripName}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
            <Label Text="{Binding TripDate, StringFormat='{0:D}'}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            <Label Text="{Binding CatchesBySpeciesSummary}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
        </VerticalStackLayout>

        <!-- Map with catch pins (zoom and pan enabled) -->
        <Border Grid.Row="1"
                HeightRequest="300"
                Margin="0,0,0,5"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Border.BackgroundColor>
                <AppThemeBinding Light="#E8E8E8" Dark="#2C2C2C"/>
            </Border.BackgroundColor>
            <Grid>
                <maps:Map x:Name="CatchesMap"
                          IsZoomEnabled="True"
                          IsScrollEnabled="True"
                          MapType="Street"/>
                <!-- Debug: remove when map works -->
                <Label x:Name="MapDebugLabel"
                       Text="Map loading..."
                       FontSize="10"
                       TextColor="#666666"
                       BackgroundColor="#E0FFFFFF"
                       Padding="6,2"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       Margin="4"/>
            </Grid>
        </Border>

        <Label Text="Map not to be used for navigation" 
               FontSize="10"
               HorizontalTextAlignment="Center"
               Grid.Row="2"/>

        <!-- Catches List -->
        <Border Grid.Row="3"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                Padding="12"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <CollectionView x:Name="CatchesCollectionView"
                            ItemsSource="{Binding Catches}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No catches on this trip."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="e:CatchDataEntity">
                        <Border Style="{StaticResource InfoCard}"
                                Margin="0,5,10,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCatchTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,Auto,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="5">

                                <Label Text="🐟"
                                       FontSize="32"
                                       Grid.RowSpan="3"
                                       VerticalOptions="Center"/>

                                <Label Text="{Binding FishName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       Grid.Column="1"
                                       Grid.Row="0"/>

                                <Label Text="{Binding FormattedTime}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                       Grid.Column="2"
                                       Grid.Row="0"/>

                                <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="📍 "/>
                                            <Span Text="{Binding FormattedLatitude}"/>
                                            <Span Text="   "/>
                                            <Span Text="{Binding FormattedLongitude}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label Text="{Binding Timestamp, StringFormat='Time {0}'}"
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                       FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="4"
                Text="Close"
                Clicked="OnCloseClicked"
                BackgroundColor="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"
                TextColor="#FFFFFF"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,20,0,0"/>
    </Grid>
</ContentPage>
