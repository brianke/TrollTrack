<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             x:Class="TrollTrack.Features.Catches.TripCatchesPopup"
             x:DataType="vm:TripCatchesDisplay"
             xmlns:vm="clr-namespace:TrollTrack.Features.Catches"
             Title="Trip Catches"
             BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1C1C1C}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,10,0,20">
            <Label Text="🎣"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="{Binding TripName}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
            <Label Text="{Binding TripDate, StringFormat='{0:D}'}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            <Label Text="{Binding CatchesCount, StringFormat='{0} catches'}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
        </VerticalStackLayout>

        <!-- Catches List -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                Padding="12"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <CollectionView x:Name="CatchesCollectionView"
                            ItemsSource="{Binding Catches}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No catches on this trip."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="e:CatchDataEntity">
                        <Border Style="{StaticResource InfoCard}"
                                Margin="0,5,10,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCatchTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="5">

                                <Label Text="🐟"
                                       FontSize="32"
                                       Grid.RowSpan="3"
                                       VerticalOptions="Center"/>

                                <Label Text="{Binding FishName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       Grid.Column="1"
                                       Grid.Row="0"/>

                                <Label Text="{Binding Timestamp, StringFormat='{0:t}'}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                       Grid.Column="2"
                                       Grid.Row="0"/>

                                <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="📍 "/>
                                            <Span Text="{Binding Latitude, StringFormat='{0:F4}'}"/>
                                            <Span Text=", "/>
                                            <Span Text="{Binding Longitude, StringFormat='{0:F4}'}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Label Text="{Binding Timestamp, StringFormat='{0:M/d/yyyy}'}"
                                       Grid.Column="1"
                                       Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                       FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="2"
                Text="Close"
                Clicked="OnCloseClicked"
                BackgroundColor="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"
                TextColor="#FFFFFF"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,20,0,0"/>
    </Grid>
</ContentPage>
