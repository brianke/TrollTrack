<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="CatchesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrollTrack.Features.Catches.CatchesView"
             xmlns:vm="clr-namespace:TrollTrack.Features.Catches"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             x:DataType="vm:CatchesViewModel">

    <!--<RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCatchesCommand}">-->
    <ScrollView>
        <VerticalStackLayout>
            <!-- No active Trip -->
            <VerticalStackLayout Spacing="15" Padding="15"
                                 IsVisible="{Binding HasActiveTrip, Converter={StaticResource InvertedBoolConverter}}">

                <!-- Start New Trip Section -->
                <Border Style="{StaticResource InfoCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Start New Trip" 
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>

                        <Label Text="Trip Name"/>
                        <Entry Text="{Binding NewTripName}"
                               Placeholder="e.g., Lake Erie Morning Run"/>

                        <Label Text="Trip Date"/>
                        <DatePicker Date="{Binding NewTripDate}"
                                    Format="D"/>

                        <Button Text="🚤 Start Trip"
                                Command="{Binding StartNewTripCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- View Past Trips Section -->
                <CollectionView ItemsSource="{Binding RecentTrips}"
                                SelectionMode="Single">
                    <!--SelectionChanged="OnTripSelectionChanged">-->
                    <CollectionView.EmptyView>
                        <Label Text="No trips yet. Start your first trip!"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray500}"
                               Margin="0,20"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="e:TripDataEntity">
                            <Border Style="{StaticResource InfoCard}"
                                    Margin="0,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTripTapped"/>
                                    <!--<TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatchesViewModel}}, Path=ViewTripDetailsCommand}"
                                            CommandParameter="{Binding .}" />-->
                                </Border.GestureRecognizers>

                            <!--<Button Text="{Binding TripName}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatchesViewModel}}, Path=ViewTripDetailsCommand}"
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="{StaticResource Primary}"
                                    Margin="0,10,0,0">
                                </Button>-->
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <Label Text="{Binding TripName}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                Grid.Row="0" Grid.Column="0"/>

                                <Label Text="🎣 ACTIVE"
                                           TextColor="Green"
                                           FontAttributes="Bold"
                                           Grid.Row="0" Grid.Column="1"
                                           IsVisible="{Binding IsActive}"/>

                                <Label Text="{Binding TripDate, StringFormat='{0:D}'}"
                                           Grid.Row="1" Grid.Column="0"
                                           Grid.ColumnSpan="2"/>

                                <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                    <Label Text="{Binding CatchCount}"/>
                                    <Label Text=" catches"/>
                                    <Label Text=" • "/>
                                    <Label Text="{Binding Location}"/>
                                </HorizontalStackLayout>
                            </Grid>
                            
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Active Trip -->
            <VerticalStackLayout Spacing="15" Padding="15"
                                 IsVisible="{Binding HasActiveTrip}">

                <!-- Active Trip Info Banner -->
                <Border Style="{StaticResource InfoCard}"
                            BackgroundColor="{StaticResource Primary}" >
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="🎣" FontSize="24"/>
                        <Label Text="{Binding ActiveTrip.TripName}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </Border>
            
                <!-- End Trip Button -->
                <Button Text="End Trip"
                        Command="{Binding EndActiveTripCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        Margin="0,10,0,0"/>

                <!-- Add New Rod Section -->
                <Border Style="{StaticResource InfoCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Add Rod"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>
                        <Button Text="+ Add Rod"
                                Style="{StaticResource CircularButton}"
                                WidthRequest="120"
                                HeightRequest="40"
                                CornerRadius="20"
                                Command="{Binding AddRodCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Add Catch Section -->
                <Border Style="{StaticResource InfoCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Log New Catch"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>

                        <Label Text="No rods configured. Add a rod first!"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray500}"
                               Margin="0,10"
                               IsVisible="{Binding HasNoRods}"/>

                        <FlexLayout BindableLayout.ItemsSource="{Binding Rods}"
                                    Wrap="Wrap"
                                    JustifyContent="Center"
                                    AlignItems="Start"
                                    AlignContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="e:RodEntity">
                                    <Border Style="{StaticResource InfoCard}"
                                            Margin="5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAddCatchTapped"/>
                                        </Border.GestureRecognizers>

                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource CardTitle}"
                                                   HorizontalOptions="Center"/>
                                           
                                            <!--<Button Text="+"
                                                    Style="{StaticResource CircularButton}"
                                                    WidthRequest="120"
                                                    HeightRequest="40"
                                                    CornerRadius="20" />-->
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                                <!--<DataTemplate x:DataType="e:RodEntity">
                                    <Button Text="{Binding Name}"
                                        Style="{StaticResource AddCatchButton}"
                                        FontSize="12"
                                        Padding="5"
                                        Margin="5"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CatchesViewModel}}, Path=AddNewCatchCommand}" />-->
                                    <!--CommandParameter="{Binding .}"/>
                                </DataTemplate>-->
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>