<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="CatchesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrollTrack.Features.Catches.CatchesView"
             xmlns:f="clr-namespace:TrollTrack.Features.Catches"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             x:DataType="f:CatchesViewModel">

    <!--<RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCatchesCommand}">-->
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="15">

                <!-- Active Trip Info Banner -->
                <Border Style="{StaticResource InfoCard}"
                        BackgroundColor="{StaticResource Primary}"
                        IsVisible="{Binding HasActiveTrip}">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="🎣" FontSize="24"/>
                        <Label Text="{Binding ActiveTrip.TripName}"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!--<Label Text="{Binding RefreshStatus}" 
                       Style="{StaticResource InfoLabel}"
                       Margin="0,0,0,5"/>-->

                <!-- Statistics -->
                <Border Style="{StaticResource InfoCard}">
                    <Grid ColumnDefinitions="*,*" RowSpacing="10">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="{Binding TodaysCatches}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Today"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="{Binding TotalCatches}"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Total"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Add New Rod Section -->
                <Border Style="{StaticResource InfoCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Add Rod"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>
                        <Button Text="+ Add Rod"
                                Style="{StaticResource CircularButton}"
                                WidthRequest="120"
                                HeightRequest="40"
                                CornerRadius="20"
                                Command="{Binding AddRodCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Add Catch Section -->            
                <Border Style="{StaticResource InfoCard}"
                        x:Name="CatchSection">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Log New Catch"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>

                        <Label Text="No rods configured. Add a rod first!"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray500}"
                               Margin="0,10"
                               IsVisible="{Binding HasNoRods}"/>

                    <FlexLayout BindableLayout.ItemsSource="{Binding Rods}"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Start"
                                AlignContent="Start">   
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="e:RodEntity">
                                <Button Text="{Binding Name}"
        BackgroundColor="Blue"
        TextColor="White"
        WidthRequest="100"
        HeightRequest="100"
        Margin="5"
        Command="{Binding Source={x:Reference CatchesPage}, Path=BindingContext.AddNewCatchCommand}"/>
                                <!--<Button Text="{Binding Name}"
                                        Style="{StaticResource AddCatchButton}"
                                        FontSize="12"
                                        Padding="5"
                                        Margin="5"
                                        Command="{Binding Source={x:Reference CatchSection}, Path=BindingContext.AddNewCatchCommand}" />-->
                                <!--CommandParameter="{Binding .}"/>-->
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <!--       <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label Text="Species: "
                                   Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                            <Picker Title="Select"
                                    ItemsSource="{Binding FishOptions}"
                                    SelectedItem="{Binding SelectedFishOption, Mode=TwoWay}"
                                    Style="{StaticResource CardPicker}"
                                    MinimumWidthRequest="200"/>
                        </HorizontalStackLayout>

                        <Button Text="+ Add Catch"
                                Style="{StaticResource CircularButton}"
                                WidthRequest="120"
                                HeightRequest="40"
                                CornerRadius="20"
                                Command="{Binding AddNewCatchCommand}"/>-->
                    </VerticalStackLayout>
                </Border>

                <!-- Catches List -->
                <Border Style="{StaticResource InfoCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Catch History"
                               Style="{StaticResource CardTitle}"
                               HorizontalOptions="Center"/>

                        <CollectionView ItemsSource="{Binding Catches}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No catches yet. Log your first catch!"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource Gray500}"
                                       Margin="0,20"/>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="e:CatchDataEntity">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems>
                                                <SwipeItem Text="Delete"
                                                          BackgroundColor="Red"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type f:CatchesViewModel}}, Path=DeleteCatchCommand}"
                                                          CommandParameter="{Binding .}"/>
                                            </SwipeItems>
                                        </SwipeView.RightItems>

                                        <Border Style="{StaticResource InfoCard}"
                                                Margin="0,5">
                                            <Grid ColumnDefinitions="Auto,*,Auto" 
                                                  RowDefinitions="Auto,Auto,Auto"
                                                  ColumnSpacing="10"
                                                  RowSpacing="5">

                                                <!-- Fish Icon/Emoji -->
                                                <Label Text="🐟"
                                                       FontSize="32"
                                                       Grid.RowSpan="3"
                                                       VerticalOptions="Center"/>

                                                <!-- Species Name -->
                                                <Label Text="{Binding FishInfo.CommonName}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       Grid.Column="1"
                                                       Grid.Row="0"/>

                                                <!-- Time -->
                                                <Label Text="{Binding Timestamp, StringFormat='{0:t}'}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource Gray500}"
                                                       Grid.Column="2"
                                                       Grid.Row="0"/>

                                                <!-- Location -->
                                                <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="📍 "/>
                                                            <Span Text="{Binding Location.Latitude, StringFormat='{0:F4}'}"/>
                                                            <Span Text=", "/>
                                                            <Span Text="{Binding Location.Longitude, StringFormat='{0:F4}'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <!-- Date (if not today) -->
                                                <Label Text="{Binding Timestamp, StringFormat='{0:M/d/yyyy}'}"
                                                       Grid.Column="1"
                                                       Grid.Row="2"
                                                       Grid.ColumnSpan="2"
                                                       TextColor="{StaticResource Gray500}"
                                                       FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    <!--</RefreshView>-->
</ContentView>