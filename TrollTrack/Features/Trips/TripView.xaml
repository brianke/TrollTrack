<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrollTrack.Features.Trips.TripView"
             xmlns:vm="clr-namespace:TrollTrack.Features.Trips"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             x:DataType="vm:TripViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            
            <!-- Active Trip Section -->
            <Border Style="{StaticResource InfoCard}" 
                    IsVisible="{Binding HasActiveTrip}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎣 Active Trip" 
                           Style="{StaticResource CardTitle}"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding ActiveTrip.TripName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="*,*" 
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="5">

                        <Label Text="Duration:" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                        <Label Text="{Binding ActiveTripDuration}" Grid.Row="0" Grid.Column="1"/>

                        <Label Text="Catches:" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                        <Label Text="{Binding ActiveTrip.CatchCount}" Grid.Row="1" Grid.Column="1"/>

                        <!--<Label Text="Location:" FontAttributes="Bold" Grid.Row="2" Grid.Column="0"/>
                        <Label Text="{Binding ActiveTrip.Location}" Grid.Row="2" Grid.Column="1"/>-->
                    </Grid>

                    <Button Text="End Trip"
                            Command="{Binding EndActiveTripCommand}"
                            BackgroundColor="OrangeRed"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Start New Trip Section -->
            <Border Style="{StaticResource InfoCard}"
                    IsVisible="{Binding HasActiveTrip, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Start New Trip" 
                           Style="{StaticResource CardTitle}"
                           HorizontalOptions="Center"/>

                    <Label Text="Trip Name"/>
                    <Entry Text="{Binding NewTripName}"
                           Placeholder="e.g., Lake Erie Morning Run"/>

                    <Label Text="Trip Date"/>
                    <DatePicker Date="{Binding NewTripDate}"
                                Format="D"/>

                    <Button Text="🚤 Start Trip"
                            Command="{Binding StartNewTripCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Recent Trips Section -->
            <Border Style="{StaticResource InfoCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Recent Trips" 
                           Style="{StaticResource CardTitle}"
                           HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding RecentTrips}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No trips yet. Start your first trip!"
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource Gray500}"
                                   Margin="0,20"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="e:TripDataEntity">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Delete"
                                                      BackgroundColor="Red"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TripViewModel}}, Path=DeleteTripCommand}"
                                                      CommandParameter="{Binding .}"/>
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Style="{StaticResource InfoCard}"
                                            Margin="0,5">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TripViewModel}}, Path=ViewTripDetailsCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <Label Text="{Binding Name}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   Grid.Row="0" Grid.Column="0"/>

                                            <Label Text="🎣 ACTIVE"
                                                   TextColor="Green"
                                                   FontAttributes="Bold"
                                                   Grid.Row="0" Grid.Column="1"
                                                   IsVisible="{Binding IsActive}"/>

                                            <Label Text="{Binding TripDate, StringFormat='{0:D}'}"
                                                   Grid.Row="1" Grid.Column="0"
                                                   Grid.ColumnSpan="2"/>

                                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                                <Label Text="{Binding CatchCount}"/>
                                                <Label Text=" catches"/>
                                                <Label Text=" • "/>
                                                <Label Text="{Binding Location}"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!--<Label Text="{Binding RefreshStatus}" 
                   Style="{StaticResource InfoLabel}"/>-->
        </VerticalStackLayout>
    </ScrollView>
</ContentView>