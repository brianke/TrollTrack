<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrollTrack.Features.Lures"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             xmlns:converters="clr-namespace:TrollTrack.Converters"
             x:Class="TrollTrack.Features.Lures.AddLurePopup"
             x:DataType="vm:AddLureViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1C1C1C}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EnumToDisplayStringConverter x:Key="EnumToDisplayStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,10,0,20">
            <Label Text="{Binding Title}"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
        </VerticalStackLayout>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                <!-- Line Out Entry Section -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                        Padding="20"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#40000000, Dark=#80000000}"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.3"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Manufacturer"
                               FontSize="18"
                               FontAttributes="Bold"                               
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />

                        <Entry Grid.Column="0"
                               Text="{Binding Manufacturer}"
                               Placeholder="Enter manufacturer name"
                               FontSize="16"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" />
                        
                        <Label Text="Type"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Picker ItemsSource="{Binding LureTypeList}"
                                SelectedItem="{Binding SelectedLureType}">
                            <Picker.ItemDisplayBinding>
                                <Binding Path="." Converter="{StaticResource EnumToDisplayStringConverter}" />
                            </Picker.ItemDisplayBinding>
                        </Picker>

                        <Label Text="Description"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Entry Text="{Binding LureDescription}"
                               Placeholder="Enter description"
                               FontSize="16"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}"
                               Grid.Column="0" />

                        <Label Text="Buoyancy"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Picker ItemsSource="{Binding BuoyancyList}"
                                SelectedItem="{Binding SelectedBuoyancy}">
                            <Picker.ItemDisplayBinding>
                                <Binding Path="." Converter="{StaticResource EnumToDisplayStringConverter}" />
                            </Picker.ItemDisplayBinding>
                        </Picker>

                        <Label Text="Length (in)"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Entry Text="{Binding LengthText}"
                               Placeholder="Enter length"
                               Keyboard="Numeric"
                               FontSize="16"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}" />

                        <Label Text="Weight (oz)"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                        <Entry Text="{Binding WeightText}"
                               Placeholder="Enter weight in ounces"
                               Keyboard="Numeric"
                               FontSize="16"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#3C3C3C}"
                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#999999, Dark=#777777}"
                               Grid.Column="0" />

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" 
            ColumnDefinitions="*,*" 
            ColumnSpacing="15"
            Margin="0,20,0,10">

            <!-- Cancel Button -->
            <Button Grid.Column="0"
                Text="Cancel"
                Command="{Binding CancelAddLureCommand}"
                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"/>

            <!-- Add Lure Button -->
            <Button Grid.Column="1"
                Text="{Binding AddButtonText}"
                Command="{Binding AddLureCommand}"
                BackgroundColor="{AppThemeBinding Light=#2E8BC0, Dark=#4A9FD8}"
                TextColor="#FFFFFF"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#CCCCCC, Dark=#555555}" />
                    </Trigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Grid>
</ContentPage>
