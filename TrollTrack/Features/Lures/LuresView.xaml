<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="LuresPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:e="clr-namespace:TrollTrack.Features.Shared.Models.Entities"
             xmlns:vm="clr-namespace:TrollTrack.Features.Lures"
             x:Class="TrollTrack.Features.Lures.LuresView"
             x:DataType="vm:LuresViewModel"
             Title="{Binding Title}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button Text="+ Add Lure"
                Style="{StaticResource CircularButton}"
                WidthRequest="120"
                HeightRequest="40"
                CornerRadius="20"
                Command="{Binding AddLureCommand}" />


        <CollectionView ItemsSource="{Binding Lures}"
                        Grid.Row="1"
                        Margin="4,0">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="6"
                                 VerticalItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="e:LureDataEntity">
                    <Grid Margin="2">
                        <Border Style="{StaticResource LureCard}"
                                Padding="6"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <VerticalStackLayout Spacing="6">
                                <Border StrokeThickness="0"
                                        BackgroundColor="{StaticResource Gray100}"
                                        StrokeShape="RoundRectangle 6"
                                        HeightRequest="140">
                                    <Image Source="{Binding PrimaryImage.Path}"
                                           HorizontalOptions="Fill"
                                           InputTransparent="True" />
                                </Border>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Description}"
                                           Style="{StaticResource LureTitle}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           InputTransparent="True" />
                                    <Label Text="{Binding Manufacturer}"
                                           Style="{StaticResource LureSubtitle}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           InputTransparent="True" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*,*">
                                    <VerticalStackLayout>
                                        <Label Text="Buoyancy" Style="{StaticResource LureDetailLabel}" InputTransparent="True" />
                                        <Label Text="{Binding Buoyancy}" Style="{StaticResource LureDetailLabel}" InputTransparent="True" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Length" Style="{StaticResource LureDetailLabel}" InputTransparent="True" />
                                        <Label Text="{Binding Length, StringFormat='{0:F2} '}" Style="{StaticResource LureDetailLabel}" InputTransparent="True" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="Weight" Style="{StaticResource LureDetailLabel}" InputTransparent="True" />
                                        <Label Text="{Binding Weight, StringFormat='{0:F3} oz'}" Style="{StaticResource LureDetailLabel}" InputTransparent="True" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Button BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                CornerRadius="8"
                                CommandParameter="{Binding .}"
                                Clicked="OnLureClicked"
                                Pressed="OnLurePressed"
                                Released="OnLureReleased"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Image Modal Overlay -->
        <!-- Put this as the LAST child of your root Grid on the Lures page -->
        <Grid IsVisible="{Binding IsImageModalVisible}"
              BackgroundColor="#80000000"
              ZIndex="999"
              RowDefinitions="*"
              ColumnDefinitions="*"
              x:DataType="vm:LuresViewModel"
              Grid.RowSpan="2">

            <!-- Optional: tap outside to close -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseImageCommand}" />
            </Grid.GestureRecognizers>

            <!-- Modal card that fills most of the screen -->
            <Border Margin="12"
                    Padding="10"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

                <Grid RowDefinitions="Auto,*">

                    <!-- Close button -->
                    <Button Text="✕"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Command="{Binding CloseImageCommand}" />

                    <!-- BIG image -->
                    <Image Grid.Row="1"
                           Source="{Binding SelectedImagePath}"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>